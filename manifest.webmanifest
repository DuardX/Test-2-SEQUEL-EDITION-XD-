{
  "id": "./",
  "name": "Markdown Assembler",
  "short_name": "MD Assembler",
  "description": "MarkDownload → .md → Assemble → ready TXT",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#121110",
  "theme_color": "#121110",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": [
      { "name": "title" },
      { "name": "text" },
      {
        "name": "file",
        "accept": {
          "text/markdown": [".md", ".markdown"],
          "text/plain": [".txt"]
        }
      }
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      },
      "launch_type": "focus-existing"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}